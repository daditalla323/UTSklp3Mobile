<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Status Badge (WIN: 🏆 MENANG / LOSS: 💔 KALAH) -->
        <TextView
            android:id="@+id/tvHistoryResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏆 MENANG"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#15803D"
            android:background="@drawable/bg_badge_win"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tvHistoryMatkul"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pemrograman Mobile"
                android:textColor="#1F2937"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHistoryOpponent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="vs Lawan • 12/10/2023"
                android:textColor="#6B7280"
                android:textSize="12sp"
                android:layout_marginTop="3dp" />

        </LinearLayout>

        <!-- Points badge -->
        <TextView
            android:id="@+id/tvHistoryPoints"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+30 Pts"
            android:textColor="#2563EB"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="#EFF6FF"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>