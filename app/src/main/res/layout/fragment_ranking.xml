<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FB"
    tools:context=".ui.ranking.RankingFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="150dp">

        <!-- HEADER BIRU & FILTER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_curve"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="28dp"
            android:paddingEnd="20dp"
            android:paddingBottom="52dp">

            <!-- Baris 1: Judul Kiri & Tombol Ikon Kanan -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Judul & Subjudul Kiri -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quiz Battle Arena"
                        android:textColor="#95CCDD"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Peringkat Pemain"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Tombol Ikon Search & Info Kanan -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal">

                    <!-- Tombol Search -->
                    <ImageView
                        android:id="@+id/btnHeaderSearch"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_circle_icon"
                        android:clickable="true"
                        android:contentDescription="Search"
                        android:focusable="true"
                        android:padding="9dp"
                        android:src="@android:drawable/ic_menu_search"
                        app:tint="#FFFFFF" />

                    <!-- Tombol Info -->
                    <ImageView
                        android:id="@+id/btnHeaderInfo"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_circle_icon"
                        android:clickable="true"
                        android:contentDescription="Info"
                        android:focusable="true"
                        android:padding="9dp"
                        android:src="@android:drawable/ic_dialog_info"
                        app:tint="#FFFFFF" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Baris 2: Tombol Filter (Terbaru & Semua) Kiri, Timer Badge Kanan -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <!-- Tombol Filter Kiri -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal">

                    <!-- TOMBOL TERBARU -->
                    <TextView
                        android:id="@+id/btnFilterTerbaru"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_filter_pill_inactive"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="9dp"
                        android:text="Terbaru"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- TOMBOL SEMUA (AKTIF) -->
                    <TextView
                        android:id="@+id/btnFilterSemua"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_filter_pill"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="9dp"
                        android:text="Semua"
                        android:textColor="#293681"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Timer Badge Kanan ("3 hari lagi") -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_timer_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🕒"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="3 hari lagi"
                        android:textColor="#FFD700"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>

        <!-- 1. TAMPILAN TERBARU (LIST PERINGKAT TERBARU / RECENT RANKED PLAYERS) -->
        <LinearLayout
            android:id="@+id/layoutTerbaru"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:layout_marginTop="-30dp"
            android:visibility="gone">

            <!-- KARTU EMPTY STATE (BILA BELUM ADA BERMAIN) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardEmptyTerbaru"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="32dp">

                    <ImageView
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:src="@drawable/maskot_qba"
                        android:background="@drawable/bg_circle_avatar"
                        android:padding="16dp"
                        android:scaleType="centerInside" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="Peringkat Terbaru Kosong 🏆"
                        android:textColor="#293681"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Belum ada aktivitas tanding di periode terbaru ini.\nMulai bertanding sekarang dan jadilah Juara Terbaru!"
                        android:textColor="#95CCDD"
                        android:textSize="12sp"
                        android:textAlignment="center"
                        android:lineSpacingExtra="2dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStartBattle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="Mulai Battle ⚔️"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="#293681"
                        app:cornerRadius="16dp"
                        android:paddingHorizontal="32dp"
                        android:paddingVertical="12dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- RECYCLERVIEW UNTUK LIST PERINGKAT TERBARU -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTerbaru"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone"
                tools:listitem="@layout/item_ranking" />
        </LinearLayout>

        <!-- 2. TAMPILAN SEMUA (DAFTAR PERINGKAT) - DEFAULT MUNCUL -->
        <LinearLayout
            android:id="@+id/layoutSemua"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:layout_marginTop="-30dp"
            android:visibility="visible">

            <!-- CARD PODIUM -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="bottom|center_horizontal"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingTop="24dp"
                    android:paddingBottom="24dp">

                    <!-- JUARA 2 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                        <ImageView
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:background="@drawable/bg_circle_avatar"
                            android:padding="10dp"
                            android:src="@drawable/ic_person"
                            app:tint="#293681" />
                        <TextView
                            android:id="@+id/tvPodium2Name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Dadi"
                            android:textColor="#293681"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvPodium2Points"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="8.500 Poin"
                            android:textColor="#4274D9"
                            android:textSize="10sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="70dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_podium_2_3"
                            android:gravity="center">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2"
                                android:textColor="#FFFFFF"
                                android:textSize="28sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- JUARA 1 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="👑"
                            android:textSize="20sp" />
                        <ImageView
                            android:layout_width="65dp"
                            android:layout_height="65dp"
                            android:background="@drawable/bg_circle_avatar"
                            android:padding="12dp"
                            android:src="@drawable/ic_person"
                            app:tint="#293681" />
                        <TextView
                            android:id="@+id/tvPodium1Name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Anggun"
                            android:textColor="#293681"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvPodium1Points"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="9.000 Poin"
                            android:textColor="#4274D9"
                            android:textSize="11sp" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="100dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_podium_1"
                            android:gravity="center">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1"
                                android:textColor="#293681"
                                android:textSize="36sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- JUARA 3 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                        <ImageView
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:background="@drawable/bg_circle_avatar"
                            android:padding="10dp"
                            android:src="@drawable/ic_person"
                            app:tint="#293681" />
                        <TextView
                            android:id="@+id/tvPodium3Name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Hafsa"
                            android:textColor="#293681"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvPodium3Points"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="8.000 Poin"
                            android:textColor="#4274D9"
                            android:textSize="10sp" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_podium_2_3"
                            android:gravity="center">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="3"
                                android:textColor="#FFFFFF"
                                android:textSize="28sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- JUDUL LIST -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Peringkat Lainnya"
                    android:textColor="#293681"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="300+ pemain"
                    android:textColor="#95CCDD"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- RecyclerView untuk Peringkat #4 ke bawah -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRanking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_ranking" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>