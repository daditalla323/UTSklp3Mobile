<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#293681"
    tools:context=".ui.auth.LoginActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Aksen Hiasan Melengkung Atas Kanan -->
        <View
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:layout_marginEnd="-40dp"
            android:layout_marginTop="-40dp"
            android:background="@drawable/bg_circle_accent_bright" />

        <!-- Aksen Hiasan Melengkung Atas Kiri -->
        <View
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="-30dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_circle_accent_soft" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <!-- Logo / Maskot Arena -->
            <ImageView
                android:id="@+id/ivMascot"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_marginTop="28dp"
                android:src="@drawable/ic_launcher_foreground"
                android:contentDescription="Maskot Game" />

            <!-- Header Teks -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Siap Bertanding?"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Masuk dan tantang temanmu di Quiz Arena!"
                android:textColor="#95CCDD"
                android:textSize="14sp"
                android:textAlignment="center"
                android:layout_marginBottom="20dp" />

            <!-- Card Form Login (Warna #95CCDD) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#95CCDD"
                app:cardCornerRadius="24dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Input Username / Email -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilUsername"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Nama Pengguna / Email"
                        android:textColorHint="#293681"
                        app:boxBackgroundMode="filled"
                        app:boxBackgroundColor="#FFFFFF"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:boxStrokeColor="#293681"
                        app:hintTextColor="#293681">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etUsername"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName"
                            android:textColor="#293681"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Input Password + Logo Mata Toggle -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Kata Sandi"
                        android:textColorHint="#293681"
                        app:passwordToggleEnabled="true"
                        app:passwordToggleTint="#293681"
                        app:boxBackgroundMode="filled"
                        app:boxBackgroundColor="#FFFFFF"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:boxStrokeColor="#293681"
                        app:hintTextColor="#293681">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textColor="#293681"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Baris Ingat Saya & Lupa Kata Sandi -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <CheckBox
                            android:id="@+id/cbRememberMe"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:text="Ingat Saya"
                            android:textColor="#293681"
                            android:textSize="13sp"
                            android:buttonTint="#293681" />

                        <TextView
                            android:id="@+id/tvForgotPassword"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:text="Lupa Kata Sandi?"
                            android:textColor="#293681"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:padding="4dp" />
                    </RelativeLayout>

                    <!-- Tombol Login Utama -->
                    <Button
                        android:id="@+id/btnLogin"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp"
                        android:text="MASUK &amp; BERTANDING"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:backgroundTint="#4274D9"
                        app:cornerRadius="14dp" />

                    <!-- Pembatas Atau -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginVertical="12dp"
                        android:text="— ATAU —"
                        android:textColor="#293681"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- Tombol Login Google -->
                    <Button
                        android:id="@+id/btnGoogleLogin"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="Masuk dengan Google"
                        android:textColor="#293681"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:strokeColor="#293681"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="14dp"
                        app:icon="@android:drawable/ic_menu_compass"
                        app:iconTint="#293681"
                        app:iconGravity="textStart" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Navigasi ke Halaman Register/Daftar -->
            <TextView
                android:id="@+id/tvRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Belum punya akun? Daftar Akun"
                android:textColor="#D0E7E6"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="8dp" />

        </LinearLayout>
    </RelativeLayout>
</ScrollView>